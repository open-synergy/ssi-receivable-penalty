<odoo>
<record id="batch_receivable_penalty_computation_rule_ou" model="ir.rule">
    <field
            name="name"
        >Batch Receivable Penalty Computation - Responsible to operating unit data</field>
    <field
            name="model_id"
            ref="ssi_account_receivable_penalty.model_batch_receivable_penalty_computation"
        />
    <field
            name="groups"
            eval="[(4, ref('batch_receivable_penalty_computation_ou_group'))]"
        />
    <field
            name="domain_force"
        >[('operating_unit_id','in',[g.id for g in user.operating_unit_ids])]</field>
    <field name="perm_unlink" eval="1" />
    <field name="perm_write" eval="1" />
    <field name="perm_read" eval="1" />
    <field name="perm_create" eval="1" />
</record>
</odoo>
